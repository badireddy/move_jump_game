# Copy this file to ".env" and fill in your values. ".env" is git-ignored.
# Every browser-exposed variable MUST start with VITE_.

# --- Firebase (cloud sync + profiles). Leave blank to run in local-only mode. ---
# Get these from the Firebase console: Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- AI proxy (Cloudflare Worker URL). Leave blank to disable live AI features. ---
# After deploying the worker (see README), paste its URL here, e.g.
# https://learnquest-ai.<your-subdomain>.workers.dev
VITE_AI_PROXY_URL=
